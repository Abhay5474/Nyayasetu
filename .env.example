# ───────────── NyayaSetu configuration ─────────────
# Copy to `.env` and fill in the REQUIRED values:  cp .env.example .env

# --- Database ---------------------------------------------------------------
POSTGRES_DB=nyayasetu
POSTGRES_USER=nyayasetu
POSTGRES_PASSWORD=change-me-db-password          # REQUIRED: change this

# --- Security (REQUIRED) -----------------------------------------------------
# JWT signing key, >= 32 chars. Generate:  openssl rand -base64 48
JWT_SECRET=
# Shared secret between the Spring Boot gateway and the AI service. Generate:  openssl rand -hex 32
INTERNAL_TOKEN=
JWT_EXPIRATION_MINUTES=720

# --- LLM ---------------------------------------------------------------------
# anthropic | openai | ollama | mock   ("mock" = offline extractive demo: no translation, no real simplification)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- Fallbacks (optional, recommended): used automatically when the main model fails ("503 high demand", rate limit, retired model, bad key)
# Order: main model -> LLM_FALLBACK_MODELS (same provider and key) -> FALLBACK_LLM_* (a different service)
LLM_FALLBACK_MODELS=                             # e.g. a second Gemini model: gemini-3.1-flash-lite
FALLBACK_LLM_PROVIDER=none                       # anthropic | openai | ollama | none
FALLBACK_LLM_MODEL=
FALLBACK_API_KEY=                                # defaults to ANTHROPIC_API_KEY / OPENAI_API_KEY of that provider
FALLBACK_BASE_URL=                               # OpenAI-compatible endpoint (e.g. Groq, OpenRouter) or an Ollama URL

# --- Retrieval / embeddings ----------------------------------------------------
# fastembed (multilingual ONNX model, downloaded at image build) | hash (offline, weaker)
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
# cross-encoder (multilingual reranker, ~1 GB download) | lexical | none
RERANKER=cross-encoder
RERANKER_MODEL=jinaai/jina-reranker-v2-base-multilingual

# --- Web ---------------------------------------------------------------------
FRONTEND_PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=25

# --- Deadline alerts (optional background job) -----------------------------------
ALERTS_ENABLED=false
ALERTS_CRON=0 0 8 * * *                          # daily 08:00 IST
ALERTS_REMINDER_DAYS=7,3,1,0
ALERTS_MAIL_FROM=no-reply@nyayasetu.local
# E-mail (leave MAIL_HOST empty to disable)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# SMS via Twilio (SMS_PROVIDER=twilio to enable)
SMS_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
